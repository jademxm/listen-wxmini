.page-head { display: flex; align-items: baseline; justify-content: space-between; margin: 12rpx 8rpx 28rpx; }
.page-title { font-size: 40rpx; font-weight: 500; }
.clear { color: #185fa5; }
.item { padding: 24rpx; }
.cover { width: 112rpx; height: 112rpx; border-radius: 14rpx; flex: none; background: #eef2f7; }
.cover-empty { background: #dce7f3; }
.info { flex: 1; min-width: 0; margin-left: 24rpx; }
.progress-bar { height: 6rpx; border-radius: 6rpx; background: #eceff3; margin: 14rpx 0 8rpx; }
.progress-inner { height: 6rpx; border-radius: 6rpx; background: #185fa5; }
.item-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.remove { margin-left: auto; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
