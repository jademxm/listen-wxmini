.page-head { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 8rpx 28rpx; }
.page-head > .muted { flex: none; margin-left: 16rpx; }
.page-title { font-size: 40rpx; font-weight: 500; }

/* 「枕书」品牌徽标：一弯月 + 一卷书 + 一枕，纯 CSS，无图片资源 */
.brand { display: flex; align-items: center; min-width: 0; }
.brand-text { min-width: 0; }
.brand-sub { margin-top: 2rpx; font-size: 20rpx; color: #8a93a2; letter-spacing: 1rpx; }
.brand-mark {
  position: relative; flex: none; width: 88rpx; height: 88rpx; margin-right: 20rpx;
  border-radius: 24rpx; overflow: hidden;
  background: linear-gradient(155deg, #2a4778, #16294b);
  box-shadow: 0 6rpx 16rpx rgba(22, 41, 75, 0.22);
}
.bm-moon {
  position: absolute; top: 8rpx; right: 8rpx; width: 20rpx; height: 20rpx;
  border: 3rpx solid #ffd98a; border-radius: 50%;
  border-right-color: transparent; border-bottom-color: transparent;
  transform: rotate(-40deg);
}
.bm-scroll {
  position: absolute; left: 14rpx; top: 32rpx; width: 46rpx; height: 24rpx;
  box-sizing: border-box; border: 3rpx solid #f3e7cd; border-radius: 4rpx;
  transform: rotate(-8deg);
}
.bm-roll {
  position: absolute; top: -5rpx; width: 8rpx; height: 28rpx;
  border-radius: 4rpx; background: #f3e7cd;
}
.bm-roll.left { left: -7rpx; }
.bm-roll.right { right: -7rpx; }
.bm-line { position: absolute; left: 8rpx; height: 2rpx; background: #f3e7cd; opacity: 0.75; }
.bm-line.a { top: 6rpx; width: 24rpx; }
.bm-line.b { top: 12rpx; width: 18rpx; }
.bm-pillow {
  position: absolute; left: 14rpx; right: 14rpx; bottom: 10rpx; height: 16rpx;
  border-radius: 8rpx; background: #9db6dd; transform: rotate(-4deg);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}
.album { display: flex; align-items: center; }
.album-cover { width: 112rpx; height: 112rpx; border-radius: 14rpx; flex: none; background: #eef2f7; }
.album-cover-empty { background: #dce7f3; }
.album-info { flex: 1; min-width: 0; margin-left: 24rpx; }
.album-info .muted { margin-top: 10rpx; }
.arrow { color: #9ca3af; font-size: 44rpx; margin-left: 12rpx; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
