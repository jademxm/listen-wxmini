<view class="container">
  <view class="page-head">
    <view class="brand">
      <!-- 品牌徽标：默认纯 CSS 绘制，logo.type='image' 时改走图片（见 config/brand.js） -->
      <image
        wx:if="{{brand.logo.type === 'image' && brand.logo.image}}"
        class="brand-mark brand-mark-image"
        src="{{brand.logo.image}}"
        mode="aspectFit"
      />
      <view wx:else class="brand-mark">
        <view class="bm-moon"></view>
        <view class="bm-scroll">
          <view class="bm-roll left"></view>
          <view class="bm-roll right"></view>
          <view class="bm-line a"></view>
          <view class="bm-line b"></view>
        </view>
        <view class="bm-pillow"></view>
      </view>
      <view class="brand-text">
        <view class="page-title">{{brand.name}}</view>
        <view class="brand-sub">{{brand.slogan}}</view>
      </view>
    </view>
    <view class="muted">下拉可刷新内容</view>
  </view>

  <view wx:if="{{loading}}" class="empty">{{copy.loading}}</view>

  <view wx:elif="{{error}}" class="card">
    <view class="muted">{{error}}</view>
    <view class="btn" style="margin-top:20rpx" bindtap="onRetry">{{copy.retry}}</view>
  </view>

  <block wx:else>
    <view wx:if="{{!albums.length}}" class="empty">{{copy.indexEmpty}}</view>
    <view
      wx:for="{{albums}}"
      wx:key="id"
      class="card album"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
      bindtap="openAlbum"
    >
      <image wx:if="{{item.cover_url}}" class="album-cover" src="{{item.cover_url}}" mode="aspectFill" />
      <view wx:else class="album-cover album-cover-empty"></view>
      <view class="album-info">
        <view class="title ellipsis">{{item.title}}</view>
        <view class="muted ellipsis">{{item.description || '共 ' + item.track_count + ' 集'}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </block>
</view>

<mini-player />
